# Get a free key at https://finnhub.io/register
FINNHUB_API_KEY=your_finnhub_key_here
DATABASE_URL="file:./dev.db"

# Our own cap on Finnhub REST calls, kept under the free tier's 60/minute.
# Allows FINNHUB_MAX_CALLS calls in any rolling FINNHUB_WINDOW_SECONDS window.
FINNHUB_MAX_CALLS=50
FINNHUB_WINDOW_SECONDS=60

# Simulation mode: Gemini trades 49 slices. Get a key at https://aistudio.google.com/apikey
GEMINI_API_KEY=your_gemini_key_here
# Optional. Gemini runs try free-tier models in order and move to the next one when a model is
# rate limited, overloaded or retired (the default list is in src/server/gemini.ts).
# GEMINI_MODEL is tried first; GEMINI_MODELS replaces the default list.
GEMINI_MODEL=gemini-3.5-flash
# GEMINI_MODELS=gemini-3.5-flash,gemini-3.5-flash-lite,gemini-flash-lite-latest,gemini-3.1-flash-lite
# How many runs to send at once (lower it on the free tier).
GEMINI_CONCURRENCY=2
